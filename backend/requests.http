@host = http://localhost:3000

### Isi data awal 1
POST {{host}}/barang
Content-Type: application/json

{ "nama": "Kalkulator Casio FX-991ES Plus", "kategori": "Akademik", "kondisi": "Baik", "harga": 80000, "lokasi": "Telkom University", "negosiasi": true, "deskripsi": "Kalkulator berfungsi normal, ada sedikit goresan.", "gambar": "/images/kalkulator.jpg" }

### Isi data awal 2
POST {{host}}/barang
Content-Type: application/json

{ "nama": "Headset Gaming", "kategori": "Elektronik", "kondisi": "Sangat Baik", "harga": 150000, "lokasi": "Dayeuhkolot", "status": "Dipesan", "deskripsi": "Lengkap dengan kotak dan kabel.", "gambar": "/images/headset.jpg" }

### Isi data awal 3
POST {{host}}/barang
Content-Type: application/json

{ "nama": "Jaket Hoodie", "kategori": "Fashion", "kondisi": "Baik", "harga": 100000, "lokasi": "Buah Batu", "status": "Terjual", "deskripsi": "Hoodie hitam ukuran L.", "gambar": "/images/jaket.jpg" }

### READ semua
GET {{host}}/barang

### READ satu 
GET {{host}}/barang/ID

### READ id tidak ada -> 404
GET {{host}}/barang/tidak-ada

### UPDATE
PATCH {{host}}/barang/ID
Content-Type: application/json

{ "status": "Dipesan" }

### CREATE duplikat -> 409
POST {{host}}/barang
Content-Type: application/json

{ "nama": "Headset Gaming", "kategori": "Elektronik", "kondisi": "Baik", "harga": 100000, "lokasi": "Dayeuhkolot" }

### CREATE tidak valid -> 400
POST {{host}}/barang
Content-Type: application/json

{ "nama": "ab", "kategori": "Mainan", "kondisi": "Baik", "harga": -5, "lokasi": "" }

### DELETE -> 204
DELETE {{host}}/barang/ID